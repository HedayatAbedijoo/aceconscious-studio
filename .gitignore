.venv-docx/
.~lock.*
docs/
campaigns/book-quotes/.render/
campaigns/book-quotes/out/
campaigns/book-quotes/.venv/
# Local review comparison snapshots, regenerated by scripts/preview-reviews.py.
/previews/reviews/view/
/scripts/__pycache__/

# OpenAI Sites publishing is local-only; never include it in the public repo.
/publish-to-openai-site*
/scripts/check_openai_publisher*
/__pycache__/
.openai/
.sites-checkout*/
.sites-runtime/
# Normal publication runs live outside this repo in ~/.cache/ace-openai-site/.
# Also ignore copies placed inside the repo.
/ace-openai-site/
/.cache/ace-openai-site/
/site.tar*
/preview.tar*

# Local authentication and environment secrets.
/.aws/
/.codex/
.env
.env.*
auth.json
credentials.json
*.pem
*.key
